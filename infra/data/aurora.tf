# Aurora PostgreSQL: the only system of record. Payments, ledger, idempotency keys, outbox and webhook
# deliveries all live here, so "where can a payment be lost?" has one answer, and the drills test it.
#
#   writer + reader   in different AZs; a failover (drill 5) or an AZ loss (drill 4) promotes the reader
#   storage           six copies across three AZs, encrypted with the money-data key (infra/bootstrap)
#   backups           daily, plus continuous: point-in-time restore to any second in the window (drill 6)
#   password          generated by RDS, kept in Secrets Manager, rotated weekly; never in Terraform state

locals {
  db_engine_major = split(".", var.db_engine_version)[0]
}

resource "aws_security_group" "db" {
  name        = "${var.name}-db"
  description = "Aurora PostgreSQL: reachable from EKS nodes only"
  vpc_id      = data.aws_vpc.this.id

  # No egress rules: the database never opens a connection. Terraform removes AWS's default allow-all egress.
}

# Which pods may connect is narrowed further inside the cluster: a NetworkPolicy lets only the API and the
# workers reach port 5432.
resource "aws_vpc_security_group_ingress_rule" "db_from_nodes" {
  security_group_id            = aws_security_group.db.id
  description                  = "PostgreSQL from EKS nodes (pods use their node's security group)"
  referenced_security_group_id = data.aws_security_group.nodes.id
  ip_protocol                  = "tcp"
  from_port                    = 5432
  to_port                      = 5432
}

resource "aws_rds_cluster_parameter_group" "this" {
  name        = "${var.name}-aurora-postgresql${local.db_engine_major}"
  family      = "aurora-postgresql${local.db_engine_major}"
  description = "Kessai Aurora PostgreSQL ${local.db_engine_major}: TLS only"

  # Clients must connect over TLS.
  parameter {
    name  = "rds.force_ssl"
    value = "1"
  }

  # The name contains the major version, so an upgrade creates the new group before dropping the old one.
  lifecycle {
    create_before_destroy = true
  }
}

# Created here, before the cluster, so it has a retention period: RDS would create it with none (kept forever).
# AWS-0017: No payment data in this log (statement logging is off); see the checkov skip below.
#trivy:ignore:AWS-0017
resource "aws_cloudwatch_log_group" "postgresql" {
  #checkov:skip=CKV_AWS_158:The money-data key trusts only IAM in this account, and CloudWatch Logs would need its own key-policy statement. Statement logging is off, so the log holds no payment data.
  #checkov:skip=CKV_AWS_338:Seven days on purpose: the cluster lives for one session.
  name              = "/aws/rds/cluster/${var.name}/postgresql"
  retention_in_days = var.log_retention_days
}

# When this cluster was created, e.g. 20261019T0930Z. It names the final snapshot, so every session's
# snapshot gets its own name. Fixed when created (ignore_changes) and destroyed with the cluster.
resource "terraform_data" "created" {
  input = formatdate("YYYYMMDD'T'hhmm'Z'", plantimestamp())

  lifecycle {
    ignore_changes = [input]
  }
}

resource "aws_rds_cluster" "this" {
  #checkov:skip=CKV2_AWS_8:AWS Backup covers it from infra/backup-plan, a separate long-lived stack that selects the cluster by ARN.
  #checkov:skip=CKV2_AWS_27:Statement logging would copy payment data (amounts, wallet IDs) into CloudWatch; the drills measure from the client log instead.
  #checkov:skip=CKV_AWS_162:IAM database authentication is not used; the app reads the database password through External Secrets.
  cluster_identifier = var.name
  engine             = "aurora-postgresql"
  engine_version     = var.db_engine_version
  # Never pay for RDS Extended Support: past the end of standard support, upgrade instead.
  engine_lifecycle_support = "open-source-rds-extended-support-disabled"

  database_name   = "kessai"
  master_username = "kessai_admin"

  # RDS generates the password, keeps it in Secrets Manager encrypted with the money-data key and rotates it
  # every 7 days. A Global Database does not support that, so on DR days global-database.tf supplies one.
  manage_master_user_password   = var.enable_global_database ? null : true
  master_user_secret_kms_key_id = var.enable_global_database ? null : data.aws_kms_alias.data.target_key_arn
  master_password_wo            = one(ephemeral.random_password.master[*].result)
  master_password_wo_version    = var.enable_global_database ? 1 : null

  db_subnet_group_name            = data.aws_db_subnet_group.this.name
  vpc_security_group_ids          = [aws_security_group.db.id]
  db_cluster_parameter_group_name = aws_rds_cluster_parameter_group.this.name

  storage_encrypted = true
  kms_key_id        = data.aws_kms_alias.data.target_key_arn

  # Point-in-time restore is always on in Aurora: any second within the retention window (drill 6).
  backup_retention_period      = var.db_backup_retention_days
  preferred_backup_window      = "17:00-17:30"         # 02:00 JST
  preferred_maintenance_window = "sun:18:00-sun:18:30" # Monday 03:00 JST
  copy_tags_to_snapshot        = true

  deletion_protection       = var.deletion_protection
  skip_final_snapshot       = var.skip_final_snapshot
  final_snapshot_identifier = "${var.name}-final-${lower(terraform_data.created.output)}"

  enabled_cloudwatch_logs_exports = ["postgresql"]

  # A dev cluster: changes apply now, not in the next maintenance window.
  apply_immediately = true

  # Drill 4 (infra/fis) fails the cluster over if its writer is in the impaired AZ, and finds it by this
  # tag, the default of AWS's "AZ Availability: Power Interruption" scenario.
  tags = {
    AzImpairmentPower = "DisruptRds"
  }

  # global-database.tf attaches this cluster to the global cluster; Terraform must not detach it again.
  lifecycle {
    ignore_changes = [global_cluster_identifier]
  }

  depends_on = [aws_cloudwatch_log_group.postgresql]
}

# Two instances in different AZs. The first one created becomes the writer, the other a reader that Aurora
# promotes on failover (typically under 60 s). A failover swaps the roles, so the names say where an
# instance runs, not what it does: `aws rds describe-db-clusters` shows the current writer.
# AWS-0133: Performance Insights is not needed for the drills; see the checkov skip below.
#trivy:ignore:AWS-0133
resource "aws_rds_cluster_instance" "this" {
  #checkov:skip=CKV_AWS_118:Enhanced Monitoring adds CloudWatch Logs cost; the drills time failovers from the client log and RDS events.
  #checkov:skip=CKV_AWS_353:Performance Insights is not needed for the drills; database metrics come from CloudWatch.
  #checkov:skip=CKV_AWS_226:Minor upgrades are deliberate: a Global Database needs the same minor version in both Regions (db_engine_version).
  for_each = toset(var.db_instance_az_ids)

  identifier         = "${var.name}-${each.key}"
  cluster_identifier = aws_rds_cluster.this.id
  engine             = aws_rds_cluster.this.engine
  engine_version     = aws_rds_cluster.this.engine_version
  instance_class     = var.db_instance_class
  availability_zone  = data.aws_availability_zone.db[each.key].name

  db_subnet_group_name       = data.aws_db_subnet_group.this.name
  publicly_accessible        = false
  auto_minor_version_upgrade = false
  apply_immediately          = true
}

# The database secret: made by RDS (named rds!cluster-...) normally, by global-database.tf on DR days.
locals {
  db_secret_arn = var.enable_global_database ? one(aws_secretsmanager_secret.master[*].arn) : one(aws_rds_cluster.this.master_user_secret[*].secret_arn)
}

# External Secrets (infra/platform) may read secrets under kessai/, but RDS names its secret itself, so
# this stack, which owns the secret, adds read access to exactly that one. Decrypting with the money-data
# key is already allowed by the role's own policy.
data "aws_iam_policy_document" "external_secrets_db" {
  statement {
    sid       = "ReadTheDatabaseSecret"
    actions   = ["secretsmanager:GetSecretValue", "secretsmanager:DescribeSecret"]
    resources = [local.db_secret_arn]
  }
}

resource "aws_iam_role_policy" "external_secrets_db" {
  name   = "${var.name}-db-secret"
  role   = data.aws_iam_role.external_secrets.name
  policy = data.aws_iam_policy_document.external_secrets_db.json
}
